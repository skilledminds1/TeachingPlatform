// TeachingPlatform — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrgRole {
  admin
  instructor
  student

  @@map("org_role")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled

  @@map("subscription_status")
}

enum TeacherProfileStatus {
  draft
  pending_approval
  approved
  rejected

  @@map("teacher_profile_status")
}

enum PaymentProvider {
  paypal
  stripe
  payfast

  @@map("payment_provider")
}

enum PaymentAttemptStatus {
  pending
  requires_action
  succeeded
  failed
  expired
  refunded
  partially_refunded

  @@map("payment_attempt_status")
}

enum TeacherPaymentOnboardingStatus {
  not_started
  pending
  complete
  restricted

  @@map("teacher_payment_onboarding_status")
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  completed
  no_show

  @@map("booking_status")
}

enum RescheduleProposalStatus {
  pending
  accepted
  declined
  expired
  cancelled

  @@map("reschedule_proposal_status")
}

enum VideoSessionStatus {
  scheduled
  live
  ended

  @@map("video_session_status")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

enum BillingInterval {
  monthly
  annual

  @@map("billing_interval")
}

enum PlanSaleIntervalScope {
  monthly
  annual
  both

  @@map("plan_sale_interval_scope")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum QualificationStatus {
  pending
  verified
  rejected

  @@map("qualification_status")
}

enum StudentRelationshipStatus {
  active
  archived

  @@map("student_relationship_status")
}

enum CourseStatus {
  draft
  pending_approval
  published
  rejected
  archived

  @@map("course_status")
}

enum CourseLessonAssetKind {
  video
  resource

  @@map("course_lesson_asset_kind")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
  all_levels

  @@map("course_level")
}

enum CoursePurchaseStatus {
  pending
  succeeded
  refunded
  cancelled

  @@map("course_purchase_status")
}

enum CourseDiscountType {
  percent
  fixed

  @@map("course_discount_type")
}

enum RefundRequestStatus {
  requested
  teacher_approved
  teacher_declined
  refunded
  escalated
  resolved
  cancelled

  @@map("refund_request_status")
}

enum PaymentDisputeStatus {
  open
  under_review
  resolved_won
  resolved_lost
  closed

  @@map("payment_dispute_status")
}

enum SubscriptionInvoiceStatus {
  paid
  refunded
  void

  @@map("subscription_invoice_status")
}

enum LegalDocumentType {
  terms
  privacy
  refund_policy
  teacher_agreement

  @@map("legal_document_type")
}

enum LegalAudience {
  all
  teacher

  @@map("legal_audience")
}

enum LegalAcceptanceMethod {
  email_signup
  oauth_review
  reacceptance

  @@map("legal_acceptance_method")
}

enum AccountStatus {
  active
  restricted
  suspended
  removed

  @@map("account_status")
}

enum EnforcementScope {
  messaging
  booking
  selling
  publishing

  @@map("enforcement_scope")
}

enum SafetyReportStatus {
  submitted
  triaged
  investigating
  resolved
  dismissed

  @@map("safety_report_status")
}

enum ModerationCaseType {
  refund
  safety
  conduct

  @@map("moderation_case_type")
}

enum ModerationCaseStatus {
  open
  under_review
  awaiting_response
  resolved
  closed

  @@map("moderation_case_status")
}

enum CasePriority {
  low
  normal
  high
  urgent

  @@map("case_priority")
}

enum SanctionType {
  warning
  restriction
  suspension
  delist
  removal

  @@map("sanction_type")
}

enum AppealStatus {
  submitted
  under_review
  upheld
  modified
  overturned

  @@map("appeal_status")
}

enum PrivacyRequestType {
  export
  deletion
  correction
  objection

  @@map("privacy_request_type")
}

enum PrivacyRequestStatus {
  submitted
  verifying
  in_progress
  completed
  denied
  cancelled

  @@map("privacy_request_status")
}

enum EmailOutboxStatus {
  pending
  processing
  sent
  failed

  @@map("email_outbox_status")
}

enum EmailDeliveryStatus {
  sent
  retrying
  failed

  @@map("email_delivery_status")
}

// ─── Users & Organizations ───────────────────────────────────────────────────

model User {
  id                     String        @id @default(uuid()) @db.Uuid
  email                  String        @unique
  name                   String
  avatarUrl              String?       @map("avatar_url")
  timezone               String        @default("Africa/Johannesburg")
  /// INT-13: ISO 3166-1 alpha-2. Nullable because existing accounts predate the field and
  /// are backfilled through a prompt; registration requires it. Country gates payout
  /// eligibility (PAY-14), tax evidence (PAY-06) and restricted-jurisdiction screening.
  country                String?       @db.VarChar(2)
  isPlatformAdmin        Boolean       @default(false) @map("is_platform_admin")
  accountStatus          AccountStatus @default(active) @map("account_status")
  accountStatusReason    String?       @map("account_status_reason")
  accountRestrictedUntil DateTime?     @map("account_restricted_until")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  deletedAt              DateTime?     @map("deleted_at")

  memberships              OrganizationMember[]
  teacherProfile           TeacherProfile?
  teacherPaymentAccounts   TeacherPaymentAccount[]
  availabilitySlots        Availability[]
  availabilityExceptions   AvailabilityException[]
  teacherBookings          Booking[]                   @relation("TeacherBookings")
  studentBookings          Booking[]                   @relation("StudentBookings")
  reviewsWritten           Review[]                    @relation("ReviewsWritten")
  reviewsReceived          Review[]                    @relation("ReviewsReceived")
  adminAuditLogs           AdminAuditLog[]
  complianceEvents         ComplianceEvent[]
  invitationsSent          OrganizationInvitation[]    @relation("InvitationSender")
  teacherRelationships     StudentRelationship[]       @relation("RelationshipTeacher")
  studentRelationships     StudentRelationship[]       @relation("RelationshipStudent")
  conversationsAsTeacher   Conversation[]              @relation("ConversationTeacher")
  conversationsAsStudent   Conversation[]              @relation("ConversationStudent")
  messagesSent             Message[]                   @relation("MessageSender")
  notifications            Notification[]
  coursesTaught            Course[]                    @relation("CourseTeacher")
  coursePurchases          CoursePurchase[]            @relation("CoursePurchaseStudent")
  courseSales              CoursePurchase[]            @relation("CoursePurchaseTeacher")
  courseEnrollments        CourseEnrollment[]
  courseLessonProgress     CourseLessonProgress[]
  courseCertificates       CourseCertificate[]         @relation("CourseCertificateStudent")
  courseCertificatesIssued CourseCertificate[]         @relation("CourseCertificateTeacher")
  courseReviewsWritten     CourseReview[]              @relation("CourseReviewsWritten")
  courseReviewsReceived    CourseReview[]              @relation("CourseReviewsReceived")
  courseQuestions          CourseQuestion[]            @relation("CourseQuestionsAsked")
  courseAnswers            CourseAnswer[]              @relation("CourseAnswersWritten")
  courseSalesCreated       CourseSale[]                @relation("CourseSaleTeacher")
  courseCouponsCreated     CourseCoupon[]              @relation("CourseCouponTeacher")
  courseCouponRedemptions  CourseCouponRedemption[]
  calendarConnections      CalendarConnection[]
  bookingCalendarEvents    BookingCalendarEvent[]
  rescheduleProposals      BookingRescheduleProposal[] @relation("RescheduleProposer")
  complimentaryGrants      Organization[]              @relation("ComplimentaryGrants")
  refundRequestsMade       RefundRequest[]             @relation("RefundRequestStudent")
  refundRequestsReceived   RefundRequest[]             @relation("RefundRequestTeacher")
  legalAcceptances         LegalAcceptance[]
  consentRecords           ConsentRecord[]
  safetyReportsMade        SafetyReport[]              @relation("SafetyReportReporter")
  safetyReportsReceived    SafetyReport[]              @relation("SafetyReportSubject")
  blocksCreated            UserBlock[]                 @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]                 @relation("UserBlockBlocked")
  moderationCasesReported  ModerationCase[]            @relation("ModerationCaseReporter")
  moderationCasesSubject   ModerationCase[]            @relation("ModerationCaseSubject")
  moderationCasesAssigned  ModerationCase[]            @relation("ModerationCaseAssignee")
  caseMessages             CaseMessage[]
  caseNotes                CaseNote[]
  caseEvidenceUploaded     CaseEvidence[]
  sanctionsReceived        Sanction[]                  @relation("SanctionSubject")
  sanctionsIssued          Sanction[]                  @relation("SanctionIssuer")
  appealsSubmitted         Appeal[]                    @relation("AppealAppellant")
  appealsReviewed          Appeal[]                    @relation("AppealReviewer")
  privacyRequests          PrivacyRequest[]            @relation("PrivacyRequestRequester")
  privacyRequestsAssigned  PrivacyRequest[]            @relation("PrivacyRequestAssignee")
  notificationPreference   UserNotificationPreference?
  emailOutbox              EmailOutbox[]

  @@index([email])
  @@index([accountStatus])
  @@map("users")
}

model LegalDocument {
  id           String            @id @default(uuid()) @db.Uuid
  type         LegalDocumentType
  version      String
  audience     LegalAudience     @default(all)
  title        String
  path         String
  content      String
  contentHash  String            @map("content_hash")
  effectiveAt  DateTime          @map("effective_at")
  publishedAt  DateTime          @default(now()) @map("published_at")
  supersededAt DateTime?         @map("superseded_at")
  mandatory    Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([type, effectiveAt])
  @@index([mandatory, supersededAt])
  @@map("legal_documents")
}

model LegalAcceptance {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  documentId     String                @map("document_id") @db.Uuid
  acceptedRole   String                @map("accepted_role")
  method         LegalAcceptanceMethod
  confirmedAdult Boolean               @default(true) @map("confirmed_adult")
  ipHash         String?               @map("ip_hash")
  userAgentHash  String?               @map("user_agent_hash")
  acceptedAt     DateTime              @default(now()) @map("accepted_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
  @@index([userId, acceptedAt])
  @@index([documentId])
  @@map("legal_acceptances")
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  granted       Boolean
  policyVersion String    @map("policy_version")
  source        String
  capturedAt    DateTime  @default(now()) @map("captured_at")
  withdrawnAt   DateTime? @map("withdrawn_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, capturedAt])
  @@map("consent_records")
}

model Organization {
  id                          String             @id @default(uuid()) @db.Uuid
  name                        String
  slug                        String             @unique
  planId                      String             @map("plan_id") @db.Uuid
  payfastToken                String?            @map("payfast_token")
  subscriptionStatus          SubscriptionStatus @default(active) @map("subscription_status")
  billingInterval             BillingInterval    @default(monthly) @map("billing_interval")
  currentPeriodEnd            DateTime?          @map("current_period_end")
  cancelAtPeriodEnd           Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt                 DateTime?          @map("trial_ends_at")
  graceStartedAt              DateTime?          @map("grace_started_at")
  graceEndsAt                 DateTime?          @map("grace_ends_at")
  pendingPlanId               String?            @map("pending_plan_id") @db.Uuid
  pendingBillingInterval      BillingInterval?   @map("pending_billing_interval")
  pendingChangeAt             DateTime?          @map("pending_change_at")
  dunningStage                Int                @default(0) @map("dunning_stage")
  dunningLastNoticeAt         DateTime?          @map("dunning_last_notice_at")
  complimentaryPlanId         String?            @map("complimentary_plan_id") @db.Uuid
  complimentaryExpiresAt      DateTime?          @map("complimentary_expires_at")
  complimentaryGrantedById    String?            @map("complimentary_granted_by_id") @db.Uuid
  complimentaryGrantedAt      DateTime?          @map("complimentary_granted_at")
  complimentaryPreviousPlanId String?            @map("complimentary_previous_plan_id") @db.Uuid
  complimentaryNote           String?            @map("complimentary_note")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  deletedAt                   DateTime?          @map("deleted_at")

  plan                      Plan                     @relation("OrganizationPlan", fields: [planId], references: [id])
  pendingPlan               Plan?                    @relation("PendingOrganizationPlan", fields: [pendingPlanId], references: [id])
  complimentaryPlan         Plan?                    @relation("ComplimentaryPlan", fields: [complimentaryPlanId], references: [id])
  complimentaryPreviousPlan Plan?                    @relation("ComplimentaryPreviousPlan", fields: [complimentaryPreviousPlanId], references: [id])
  complimentaryGrantedBy    User?                    @relation("ComplimentaryGrants", fields: [complimentaryGrantedById], references: [id])
  members                   OrganizationMember[]
  teacherProfiles           TeacherProfile[]
  bookings                  Booking[]
  invitations               OrganizationInvitation[]
  studentRelationships      StudentRelationship[]
  billingEvents             BillingEvent[]
  subscriptionInvoices      SubscriptionInvoice[]
  courses                   Course[]

  @@index([slug])
  @@index([planId])
  @@index([pendingPlanId])
  @@index([subscriptionStatus, graceEndsAt])
  @@index([pendingChangeAt])
  @@index([trialEndsAt])
  @@index([complimentaryPlanId])
  @@index([complimentaryExpiresAt])
  @@map("organizations")
}

model BillingEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  provider        String   @default("payfast")
  providerEventId String   @unique @map("provider_event_id")
  eventType       String   @map("event_type")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      SubscriptionInvoice?

  @@index([organizationId, createdAt])
  @@map("billing_events")
}

model SubscriptionInvoice {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  billingEventId    String                    @unique @map("billing_event_id") @db.Uuid
  providerPaymentId String                    @unique @map("provider_payment_id")
  status            SubscriptionInvoiceStatus @default(paid)
  amountCents       Int                       @map("amount_cents")
  currency          String                    @default("ZAR")
  description       String
  periodStart       DateTime                  @map("period_start")
  periodEnd         DateTime                  @map("period_end")
  issuedAt          DateTime                  @default(now()) @map("issued_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingEvent BillingEvent @relation(fields: [billingEventId], references: [id], onDelete: Restrict)

  @@index([organizationId, issuedAt])
  @@index([status])
  @@map("subscription_invoices")
}

model OrganizationMember {
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Plan {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String   @unique
  description              String?
  monthlyPriceCents        Int      @map("monthly_price_cents")
  annualPriceCents         Int      @map("annual_price_cents")
  currency                 String   @default("USD")
  studentLimit             Int?     @map("student_limit")
  monthlyLiveLessonMinutes Int?     @map("monthly_live_lesson_minutes")
  courseLimit              Int?     @map("course_limit")
  features                 String[] @default([])
  marketplaceListing       Boolean  @default(true) @map("marketplace_listing")
  videoSessions            Boolean  @default(true) @map("video_sessions")
  teacherPayments          Boolean  @default(true) @map("teacher_payments")
  highlighted              Boolean  @default(false)
  sortOrder                Int      @default(0) @map("sort_order")
  isPublic                 Boolean  @default(true) @map("is_public")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organizations                      Organization[] @relation("OrganizationPlan")
  pendingOrganizations               Organization[] @relation("PendingOrganizationPlan")
  complimentaryOrganizations         Organization[] @relation("ComplimentaryPlan")
  complimentaryPreviousOrganizations Organization[] @relation("ComplimentaryPreviousPlan")
  salePlans                          PlanSalePlan[]

  @@index([slug])
  @@index([sortOrder])
  @@map("plans")
}

model PlanSale {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  percentOff    Int                   @map("percent_off")
  startsAt      DateTime              @map("starts_at")
  endsAt        DateTime              @map("ends_at")
  active        Boolean               @default(true)
  intervalScope PlanSaleIntervalScope @default(both) @map("interval_scope")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  plans PlanSalePlan[]

  @@index([active, startsAt, endsAt])
  @@map("plan_sales")
}

model PlanSalePlan {
  saleId String @map("sale_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid

  sale PlanSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  plan Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([saleId, planId])
  @@index([planId])
  @@map("plan_sale_plans")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           OrgRole
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String           @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

model StudentRelationship {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  teacherId      String                    @map("teacher_id") @db.Uuid
  studentId      String                    @map("student_id") @db.Uuid
  status         StudentRelationshipStatus @default(active)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      User         @relation("RelationshipTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student      User         @relation("RelationshipStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, teacherId, studentId])
  @@index([organizationId, status])
  @@index([teacherId, status])
  @@index([studentId])
  @@map("student_relationships")
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teachers TeacherSubject[]
  courses  Course[]

  @@index([slug])
  @@map("subjects")
}

model TeacherProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  bio                String                   @default("")
  headline           String?
  hourlyRateCents    Int                      @default(0) @map("hourly_rate_cents")
  currency           String                   @default("USD")
  /// INT-12: hourlyRateCents normalised to USD, for the marketplace price filter and sort
  /// ONLY. Never used to charge anyone — students always pay the teacher's own listed
  /// amount in their own currency. Recomputed whenever the rate or currency changes.
  hourlyRateUsdCents Int                      @default(0) @map("hourly_rate_usd_cents")
  introVideoUrl      String?                  @map("intro_video_url")
  introVideoPath     String?                  @map("intro_video_path")
  status             TeacherProfileStatus     @default(draft)
  rejectionReason    String?                  @map("rejection_reason")
  slug               String                   @unique
  submittedAt        DateTime?                @map("submitted_at")
  /// INT-13: outcome of the sanctions-list screen run at approval, kept for audit.
  screeningStatus    SanctionsScreeningStatus @default(not_screened) @map("screening_status")
  screenedAt         DateTime?                @map("screened_at")
  screeningSource    String?                  @map("screening_source")
  screeningMatches   Json?                    @map("screening_matches")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  deletedAt          DateTime?                @map("deleted_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjects       TeacherSubject[]
  languages      TeacherLanguage[]
  qualifications TeacherQualification[]

  @@index([organizationId])
  @@index([status])
  @@index([slug])
  @@index([hourlyRateUsdCents])
  @@map("teacher_profiles")
}

model TeacherQualification {
  id               String              @id @default(uuid()) @db.Uuid
  teacherProfileId String              @map("teacher_profile_id") @db.Uuid
  title            String
  institution      String
  issuedYear       Int                 @map("issued_year")
  credentialUrl    String?             @map("credential_url")
  status           QualificationStatus @default(pending)
  rejectionReason  String?             @map("rejection_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([status])
  @@map("teacher_qualifications")
}

/// INT-10: languages a teacher can actually teach in.
///
/// There was no language field anywhere in the schema. For an international marketplace
/// this is the primary axis students search on — italki is organised entirely around it,
/// and for subject tutoring it decides whether a lesson is even possible. A student in
/// Brazil could previously filter by subject and price and still land on a teacher with no
/// shared language.
///
/// Stored as BCP-47 codes ("en", "pt-BR") so display names come from Intl.DisplayNames
/// rather than a table of translations we would have to maintain.
model TeacherLanguage {
  teacherProfileId String              @map("teacher_profile_id") @db.Uuid
  /// BCP-47 language code, lowercase.
  code             String
  proficiency      LanguageProficiency @default(conversational)

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, code])
  @@index([code])
  @@map("teacher_languages")
}

enum LanguageProficiency {
  native
  fluent
  advanced
  conversational

  @@map("language_proficiency")
}

/// INT-11: daily reference exchange rates, USD-based.
///
/// Display and ranking ONLY. Nothing is ever charged from these — students always pay the
/// teacher's listed amount in the teacher's own currency.
///
/// `asOf` is the date the SOURCE published the rate; `fetchedAt` is when we pulled it. They
/// differ, and the distinction matters: a feed that keeps returning last Friday's numbers
/// looks fresh by fetchedAt while being stale by asOf, which is exactly the failure the
/// staleness alarm has to catch.
model FxRate {
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  /// Units of quoteCurrency per 1 baseCurrency.
  rate          Decimal  @db.Decimal(20, 10)
