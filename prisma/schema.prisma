// TeachingPlatform — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrgRole {
  admin
  instructor
  student

  @@map("org_role")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled

  @@map("subscription_status")
}

enum TeacherProfileStatus {
  draft
  pending_approval
  approved
  rejected

  @@map("teacher_profile_status")
}

enum PaymentProvider {
  paypal
  stripe
  payfast

  @@map("payment_provider")
}

enum PaymentAttemptStatus {
  pending
  requires_action
  succeeded
  failed
  expired
  refunded
  partially_refunded

  @@map("payment_attempt_status")
}

enum TeacherPaymentOnboardingStatus {
  not_started
  pending
  complete
  restricted

  @@map("teacher_payment_onboarding_status")
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  completed
  no_show

  @@map("booking_status")
}

enum RescheduleProposalStatus {
  pending
  accepted
  declined
  expired
  cancelled

  @@map("reschedule_proposal_status")
}

enum VideoSessionStatus {
  scheduled
  live
  ended

  @@map("video_session_status")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

enum BillingInterval {
  monthly
  annual

  @@map("billing_interval")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum QualificationStatus {
  pending
  verified
  rejected

  @@map("qualification_status")
}

enum StudentRelationshipStatus {
  active
  archived

  @@map("student_relationship_status")
}

enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
  all_levels

  @@map("course_level")
}

enum CoursePurchaseStatus {
  pending
  succeeded
  refunded
  cancelled

  @@map("course_purchase_status")
}

// ─── Users & Organizations ───────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  avatarUrl       String?   @map("avatar_url")
  timezone        String    @default("Africa/Johannesburg")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  memberships            OrganizationMember[]
  teacherProfile         TeacherProfile?
  teacherPaymentAccounts TeacherPaymentAccount[]
  availabilitySlots      Availability[]
  availabilityExceptions AvailabilityException[]
  teacherBookings        Booking[]                @relation("TeacherBookings")
  studentBookings        Booking[]                @relation("StudentBookings")
  reviewsWritten         Review[]                 @relation("ReviewsWritten")
  reviewsReceived        Review[]                 @relation("ReviewsReceived")
  adminAuditLogs         AdminAuditLog[]
  invitationsSent        OrganizationInvitation[] @relation("InvitationSender")
  teacherRelationships   StudentRelationship[]    @relation("RelationshipTeacher")
  studentRelationships   StudentRelationship[]    @relation("RelationshipStudent")
  conversationsAsTeacher Conversation[]           @relation("ConversationTeacher")
  conversationsAsStudent Conversation[]           @relation("ConversationStudent")
  messagesSent           Message[]                @relation("MessageSender")
  notifications          Notification[]
  coursesTaught          Course[]                 @relation("CourseTeacher")
  coursePurchases        CoursePurchase[]         @relation("CoursePurchaseStudent")
  courseSales            CoursePurchase[]         @relation("CoursePurchaseTeacher")
  courseEnrollments      CourseEnrollment[]
  courseLessonProgress   CourseLessonProgress[]
  calendarConnections    CalendarConnection[]
  bookingCalendarEvents  BookingCalendarEvent[]
  rescheduleProposals    BookingRescheduleProposal[] @relation("RescheduleProposer")

  @@index([email])
  @@map("users")
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  planId             String             @map("plan_id") @db.Uuid
  payfastToken       String?            @map("payfast_token")
  subscriptionStatus SubscriptionStatus @default(trialing) @map("subscription_status")
  billingInterval    BillingInterval    @default(monthly) @map("billing_interval")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  plan                 Plan                     @relation(fields: [planId], references: [id])
  members              OrganizationMember[]
  teacherProfiles      TeacherProfile[]
  bookings             Booking[]
  invitations          OrganizationInvitation[]
  studentRelationships StudentRelationship[]
  billingEvents        BillingEvent[]
  courses              Course[]

  @@index([slug])
  @@index([planId])
  @@map("organizations")
}

model BillingEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  provider        String   @default("payfast")
  providerEventId String   @unique @map("provider_event_id")
  eventType       String   @map("event_type")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("billing_events")
}

model OrganizationMember {
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  slug               String   @unique
  monthlyPriceCents  Int      @map("monthly_price_cents")
  annualPriceCents   Int      @map("annual_price_cents")
  currency           String   @default("USD")
  studentLimit       Int?     @map("student_limit")
  monthlyLiveLessonMinutes Int? @map("monthly_live_lesson_minutes")
  courseLimit        Int?     @map("course_limit")
  features           String[] @default([])
  marketplaceListing Boolean  @default(true) @map("marketplace_listing")
  videoSessions      Boolean  @default(true) @map("video_sessions")
  teacherPayments    Boolean  @default(true) @map("teacher_payments")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organizations Organization[]

  @@index([slug])
  @@map("plans")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           OrgRole
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String           @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

model StudentRelationship {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  teacherId      String                    @map("teacher_id") @db.Uuid
  studentId      String                    @map("student_id") @db.Uuid
  status         StudentRelationshipStatus @default(active)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      User         @relation("RelationshipTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student      User         @relation("RelationshipStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, teacherId, studentId])
  @@index([organizationId, status])
  @@index([teacherId, status])
  @@index([studentId])
  @@map("student_relationships")
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teachers TeacherSubject[]
  courses  Course[]

  @@index([slug])
  @@map("subjects")
}

model TeacherProfile {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @unique @map("user_id") @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  bio             String               @default("")
  headline        String?
  hourlyRateCents Int                  @default(0) @map("hourly_rate_cents")
  currency        String               @default("USD")
  status          TeacherProfileStatus @default(draft)
  rejectionReason String?              @map("rejection_reason")
  slug            String               @unique
  submittedAt     DateTime?            @map("submitted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjects       TeacherSubject[]
  qualifications TeacherQualification[]

  @@index([organizationId])
  @@index([status])
  @@index([slug])
  @@map("teacher_profiles")
}

model TeacherQualification {
  id               String              @id @default(uuid()) @db.Uuid
  teacherProfileId String              @map("teacher_profile_id") @db.Uuid
  title            String
  institution      String
  issuedYear       Int                 @map("issued_year")
  credentialUrl    String?             @map("credential_url")
  status           QualificationStatus @default(pending)
  rejectionReason  String?             @map("rejection_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([status])
  @@map("teacher_qualifications")
}

model TeacherSubject {
  teacherProfileId String   @map("teacher_profile_id") @db.Uuid
  subjectId        String   @map("subject_id") @db.Uuid
  specialties      String[] @default([])

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, subjectId])
  @@map("teacher_subjects")
}

model TeacherPaymentAccount {
  id                 String                         @id @default(uuid()) @db.Uuid
  userId             String                         @map("user_id") @db.Uuid
  provider           PaymentProvider
  providerAccountId  String                         @map("provider_account_id")
  onboardingStatus   TeacherPaymentOnboardingStatus @default(complete) @map("onboarding_status")
  settlementCurrency String?                        @map("settlement_currency")
  country            String?
  capabilities       String[]                       @default([])
  metadata           Json?
  isDefault          Boolean                        @default(false) @map("is_default")
  isActive           Boolean                        @default(true) @map("is_active")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("teacher_payment_accounts")
}

// ─── Availability & Bookings ─────────────────────────────────────────────────

model Availability {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time()
  endTime   DateTime @map("end_time") @db.Time()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("availability")
}

model AvailabilityException {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  specificDate DateTime @map("specific_date")
  startTime    DateTime @map("start_time") @db.Time()
  endTime      DateTime @map("end_time") @db.Time()
  isBlocked    Boolean  @default(true) @map("is_blocked")
  title        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, specificDate])
  @@map("availability_exceptions")
}

model Booking {
  id                 String           @id @default(uuid()) @db.Uuid
  teacherId          String           @map("teacher_id") @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  startsAt           DateTime         @map("starts_at")
  endsAt             DateTime         @map("ends_at")
  status             BookingStatus    @default(pending_payment)
  hourlyRateCents    Int              @map("hourly_rate_cents")
  currency           String           @default("USD")
  paymentProvider    PaymentProvider? @map("payment_provider")
  paymentExternalId  String?          @map("payment_external_id")
  paymentExpiresAt   DateTime?        @map("payment_expires_at")
  cancellationReason String?          @map("cancellation_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  teacher         User                  @relation("TeacherBookings", fields: [teacherId], references: [id])
  student         User                  @relation("StudentBookings", fields: [studentId], references: [id])
  organization    Organization          @relation(fields: [organizationId], references: [id])
  videoSession    VideoSession?
  review          Review?
  paymentAttempts PaymentAttempt[]
  calendarEvents  BookingCalendarEvent[]
  rescheduleProposals BookingRescheduleProposal[]

  @@index([teacherId])
  @@index([studentId])
  @@index([organizationId])
  @@index([startsAt])
  @@index([status])
  @@index([paymentExpiresAt])
  @@map("bookings")
}

model BookingRescheduleProposal {
  id               String                   @id @default(uuid()) @db.Uuid
  bookingId        String                   @map("booking_id") @db.Uuid
  proposedById     String                   @map("proposed_by_id") @db.Uuid
  proposedStartsAt DateTime                 @map("proposed_starts_at")
  proposedEndsAt   DateTime                 @map("proposed_ends_at")
  reason           String?
  status           RescheduleProposalStatus @default(pending)
  expiresAt        DateTime                 @map("expires_at")
  respondedAt      DateTime?                @map("responded_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedBy User    @relation("RescheduleProposer", fields: [proposedById], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([proposedById])
  @@index([proposedStartsAt, proposedEndsAt])
  @@index([status, expiresAt])
  @@map("booking_reschedule_proposals")
}

model CalendarConnection {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @default("google")
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  tokenExpiresAt DateTime @map("token_expires_at")
  googleEmail    String?  @map("google_email")
  calendarId     String   @default("primary") @map("calendar_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_connections")
}

model BookingCalendarEvent {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  externalEventId String   @map("external_event_id")
  createdAt       DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
  @@map("booking_calendar_events")
}

model PaymentAttempt {
  id                    String               @id @default(uuid()) @db.Uuid
  bookingId             String?              @map("booking_id") @db.Uuid
  coursePurchaseId      String?              @map("course_purchase_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentAttemptStatus @default(pending)
  amountCents           Int                  @map("amount_cents")
  currency              String
  providerCheckoutId    String?              @map("provider_checkout_id")
  providerPaymentId     String?              @map("provider_payment_id")
  teacherMerchantId     String               @map("teacher_merchant_id")
  checkoutUrl           String?              @map("checkout_url")
  failureCode           String?              @map("failure_code")
  failureMessage        String?              @map("failure_message")
  expiresAt             DateTime             @map("expires_at")
  succeededAt           DateTime?            @map("succeeded_at")
  refundedCents         Int                  @default(0) @map("refunded_cents")
  idempotencyKey        String               @unique @map("idempotency_key")
  metadata              Json?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coursePurchase CoursePurchase? @relation(fields: [coursePurchaseId], references: [id], onDelete: Cascade)
  events         PaymentEvent[]

  @@index([bookingId])
  @@index([coursePurchaseId])
  @@index([provider, status])
  @@index([providerCheckoutId])
  @@index([providerPaymentId])
  @@index([expiresAt])
  @@map("payment_attempts")
}

// ─── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id               String      @id @default(uuid()) @db.Uuid
  teacherId        String      @map("teacher_id") @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  subjectId        String?     @map("subject_id") @db.Uuid
  slug             String      @unique
  title            String
  description      String      @default("")
  coverImageUrl    String?     @map("cover_image_url")
  priceCents       Int         @map("price_cents")
  currency         String      @default("USD")
  level            CourseLevel @default(all_levels)
  status           CourseStatus @default(draft)
  publishedAt      DateTime?   @map("published_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  teacher      User              @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  purchases    CoursePurchase[]
  enrollments  CourseEnrollment[]

  @@index([teacherId])
  @@index([organizationId])
  @@index([subjectId])
  @@index([status])
  @@index([slug])
  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id              String   @id @default(uuid()) @db.Uuid
  moduleId        String   @map("module_id") @db.Uuid
  title           String
  content         String   @default("")
  videoUrl        String?  @map("video_url")
  fileStoragePath String?  @map("file_storage_path")
  fileName        String?  @map("file_name")
  fileMimeType    String?  @map("file_mime_type")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  module   CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress CourseLessonProgress[]

  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CoursePurchase {
  id                String               @id @default(uuid()) @db.Uuid
  courseId          String               @map("course_id") @db.Uuid
  studentId         String               @map("student_id") @db.Uuid
  teacherId         String               @map("teacher_id") @db.Uuid
  amountCents       Int                  @map("amount_cents")
  currency          String
  status            CoursePurchaseStatus @default(pending)
  paymentProvider   PaymentProvider?     @map("payment_provider")
  paymentExternalId String?              @map("payment_external_id")
  paymentExpiresAt  DateTime?            @map("payment_expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         User             @relation("CoursePurchaseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher         User             @relation("CoursePurchaseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  paymentAttempts PaymentAttempt[]
  enrollment      CourseEnrollment?

  @@index([courseId])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([paymentExpiresAt])
  @@map("course_purchases")
}

model CourseEnrollment {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  purchaseId  String    @unique @map("purchase_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purchase CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseLessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("course_lesson_progress")
}

model PaymentEvent {
  id               String   @id @default(uuid()) @db.Uuid
  paymentAttemptId String?  @map("payment_attempt_id") @db.Uuid
  provider         PaymentProvider
  providerEventId  String   @map("provider_event_id")
  eventType        String   @map("event_type")
  payload          Json
  processedAt      DateTime @default(now()) @map("processed_at")

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentAttemptId])
  @@map("payment_events")
}

model VideoSession {
  id              String             @id @default(uuid()) @db.Uuid
  bookingId       String             @unique @map("booking_id") @db.Uuid
  livekitRoomName String             @map("livekit_room_name")
  status          VideoSessionStatus @default(scheduled)
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("video_sessions")
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @map("booking_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  teacherId       String       @map("teacher_id") @db.Uuid
  rating          Int
  comment         String
  status          ReviewStatus @default(pending)
  teacherResponse String?      @map("teacher_response")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User    @relation("ReviewsWritten", fields: [studentId], references: [id])
  teacher User    @relation("ReviewsReceived", fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
  @@map("reviews")
}

// ─── Communication ───────────────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  teacher  User      @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student  User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teacherId, studentId])
  @@index([teacherId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime? @map("read_at")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Platform Admin ──────────────────────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
