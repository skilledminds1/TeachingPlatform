  providerCheckoutId String?              @map("provider_checkout_id")
  providerPaymentId  String?              @map("provider_payment_id")
  teacherMerchantId  String               @map("teacher_merchant_id")
  checkoutUrl        String?              @map("checkout_url")
  failureCode        String?              @map("failure_code")
  failureMessage     String?              @map("failure_message")
  expiresAt          DateTime             @map("expires_at")
  succeededAt        DateTime?            @map("succeeded_at")
  refundedCents      Int                  @default(0) @map("refunded_cents")
  idempotencyKey     String               @unique @map("idempotency_key")
  metadata           Json?
