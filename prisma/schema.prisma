  coursePurchase CoursePurchase? @relation(fields: [coursePurchaseId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  student        User            @relation("RefundRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User            @relation("RefundRequestTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  moderationCase ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([teacherId, status])
