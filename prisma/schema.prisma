model RefundRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  bookingId             String?             @unique @map("booking_id") @db.Uuid
  coursePurchaseId      String?             @unique @map("course_purchase_id") @db.Uuid
  paymentAttemptId      String?             @map("payment_attempt_id") @db.Uuid
  studentId             String              @map("student_id") @db.Uuid
  teacherId             String              @map("teacher_id") @db.Uuid
  moderationCaseId      String?             @unique @map("moderation_case_id") @db.Uuid
  status                RefundRequestStatus @default(requested)
  requestedAmountCents  Int                 @map("requested_amount_cents")
  currency              String
  reason                String
  policyEligible        Boolean             @default(false) @map("policy_eligible")
  teacherResponse       String?             @map("teacher_response")
