model Booking {
  id                    String           @id @default(uuid()) @db.Uuid
  teacherId             String           @map("teacher_id") @db.Uuid
  studentId             String           @map("student_id") @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  startsAt              DateTime         @map("starts_at")
  endsAt                DateTime         @map("ends_at")
  status                BookingStatus    @default(pending_teacher_confirmation)
  hourlyRateCents       Int              @map("hourly_rate_cents")
  currency              String           @default("USD")
  paymentProvider       PaymentProvider? @map("payment_provider")
  paymentExternalId     String?          @map("payment_external_id")
  confirmationExpiresAt DateTime?        @map("confirmation_expires_at")
  /// Payment is an ANNOTATION on a booking, never a gate.
  ///
  /// The platform cannot see a payment it never receives, so anything recorded here is
  /// somebody's word. Confirmation runs off teacher acceptance and completion runs off
  /// attendance — both facts the platform owns — so a false claim here changes nothing
  /// material and there is nothing to be gained by lying.
  ///
  /// That only holds while lessons are 0% commission. If a cut is ever taken, a teacher who
  /// under-reports saves money, this becomes worth lying about, and the model needs escrow
  /// instead. Treat it as an invariant, not a preference.
  paymentReportedAt     DateTime?        @map("payment_reported_at")
  paymentReportedBy     String?          @map("payment_reported_by") @db.Uuid
  paymentReference      String?          @map("payment_reference")
  cancellationReason    String?          @map("cancellation_reason")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  teacher             User                        @relation("TeacherBookings", fields: [teacherId], references: [id])
  student             User                        @relation("StudentBookings", fields: [studentId], references: [id])
  organization        Organization                @relation(fields: [organizationId], references: [id])
  videoSession        VideoSession?
  review              Review?
  paymentAttempts     PaymentAttempt[]
  refundRequest       RefundRequest?
  calendarEvents      BookingCalendarEvent[]
  rescheduleProposals BookingRescheduleProposal[]

  @@index([teacherId])
  @@index([studentId])
  @@index([organizationId])
  @@index([startsAt])
  @@index([status])
  @@index([confirmationExpiresAt])
  @@map("bookings")
}

