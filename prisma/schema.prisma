  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId])
  @@index([status, openedAt])
  @@map("payment_disputes")
}

// ─── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id                 String       @id @default(uuid()) @db.Uuid
  teacherId          String       @map("teacher_id") @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  subjectId          String?      @map("subject_id") @db.Uuid
  slug               String       @unique
  title              String
  description        String       @default("")
  coverImageUrl      String?      @map("cover_image_url")
  priceCents         Int          @map("price_cents")
  currency           String       @default("USD")
  level              CourseLevel  @default(all_levels)
  status             CourseStatus @default(draft)
  certificateEnabled Boolean      @default(false) @map("certificate_enabled")
  submittedAt        DateTime?    @map("submitted_at")
  reviewedAt         DateTime?    @map("reviewed_at")
  rejectionReason    String?      @map("rejection_reason")
  publishedAt        DateTime?    @map("published_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  teacher      User                @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  purchases    CoursePurchase[]
  enrollments  CourseEnrollment[]
  certificates CourseCertificate[]
  reviews      CourseReview[]
  questions    CourseQuestion[]
  saleCourses  CourseSaleCourse[]
  coupons      CourseCoupon[]

  @@index([teacherId])
  @@index([organizationId])
  @@index([subjectId])
  @@index([status])
  @@index([slug])
  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id              String   @id @default(uuid()) @db.Uuid
  moduleId        String   @map("module_id") @db.Uuid
  title           String
  content         String   @default("")
  videoUrl        String?  @map("video_url")
  fileStoragePath String?  @map("file_storage_path")
  fileName        String?  @map("file_name")
  fileMimeType    String?  @map("file_mime_type")
  sortOrder       Int      @default(0) @map("sort_order")
  isPreview       Boolean  @default(false) @map("is_preview")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  module   CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress CourseLessonProgress[]
  assets   CourseLessonAsset[]

  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CourseLessonAsset {
  id          String                @id @default(uuid()) @db.Uuid
  lessonId    String                @map("lesson_id") @db.Uuid
  kind        CourseLessonAssetKind
  storagePath String                @map("storage_path")
  fileName    String                @map("file_name")
  mimeType    String                @map("mime_type")
  sizeBytes   Int                   @map("size_bytes")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, kind, sortOrder])
  @@index([storagePath])
  @@map("course_lesson_assets")
}

model CourseCertificate {
  id               String    @id @default(uuid()) @db.Uuid
  courseId         String    @map("course_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  teacherId        String    @map("teacher_id") @db.Uuid
  verificationCode String    @unique @map("verification_code")
  studentName      String    @map("student_name")
  courseTitle      String    @map("course_title")
  teacherName      String    @map("teacher_name")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  // MON-35: a certificate must be revocable. Without this it outlived the enrollment it was
  // earned through, so the public verification page kept vouching for a student whose
  // purchase had been refunded or whose access had been revoked.
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("CourseCertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User   @relation("CourseCertificateTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([teacherId])
  @@index([verificationCode])
  @@index([revokedAt])
  @@map("course_certificates")
}

model CoursePurchase {
  id                String               @id @default(uuid()) @db.Uuid
  courseId          String               @map("course_id") @db.Uuid
  studentId         String               @map("student_id") @db.Uuid
  teacherId         String               @map("teacher_id") @db.Uuid
  amountCents       Int                  @map("amount_cents")
  listAmountCents   Int                  @map("list_amount_cents")
  discountCents     Int                  @default(0) @map("discount_cents")
  discountSource    String?              @map("discount_source")
  courseSaleId      String?              @map("course_sale_id") @db.Uuid
  courseCouponId    String?              @map("course_coupon_id") @db.Uuid
  currency          String
  status            CoursePurchaseStatus @default(pending)
  paymentProvider   PaymentProvider?     @map("payment_provider")
  paymentExternalId String?              @map("payment_external_id")
  paymentExpiresAt  DateTime?            @map("payment_expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          User                    @relation("CoursePurchaseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher          User                    @relation("CoursePurchaseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  paymentAttempts  PaymentAttempt[]
  enrollment       CourseEnrollment?
  refundRequest    RefundRequest?
  courseSale       CourseSale?             @relation(fields: [courseSaleId], references: [id], onDelete: SetNull)
  courseCoupon     CourseCoupon?           @relation(fields: [courseCouponId], references: [id], onDelete: SetNull)
  couponRedemption CourseCouponRedemption?

  @@index([courseId])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([paymentExpiresAt])
  @@index([courseSaleId])
  @@index([courseCouponId])
  @@map("course_purchases")
}

model CourseEnrollment {
  id         String    @id @default(uuid()) @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  purchaseId String    @unique @map("purchase_id") @db.Uuid
  enrolledAt DateTime  @default(now()) @map("enrolled_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purchase CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  review   CourseReview?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseReview {
  id              String       @id @default(uuid()) @db.Uuid
  enrollmentId    String       @unique @map("enrollment_id") @db.Uuid
  courseId        String       @map("course_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  teacherId       String       @map("teacher_id") @db.Uuid
  rating          Int
  comment         String
  status          ReviewStatus @default(pending)
  teacherResponse String?      @map("teacher_response")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User             @relation("CourseReviewsWritten", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User             @relation("CourseReviewsReceived", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([teacherId, status])
  @@map("course_reviews")
}

model CourseSale {
  id            String             @id @default(uuid()) @db.Uuid
  teacherId     String             @map("teacher_id") @db.Uuid
  name          String
  discountType  CourseDiscountType @map("discount_type")
  discountValue Int                @map("discount_value")
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime           @map("ends_at")
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  teacher   User               @relation("CourseSaleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  courses   CourseSaleCourse[]
  purchases CoursePurchase[]

  @@index([teacherId, active, startsAt, endsAt])
  @@map("course_sales")
}

model CourseSaleCourse {
  saleId   String @map("sale_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  sale   CourseSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([saleId, courseId])
  @@index([courseId])
  @@map("course_sale_courses")
}

model CourseCoupon {
  id             String             @id @default(uuid()) @db.Uuid
  teacherId      String             @map("teacher_id") @db.Uuid
  courseId       String?            @map("course_id") @db.Uuid
  code           String
  discountType   CourseDiscountType @map("discount_type")
  discountValue  Int                @map("discount_value")
  startsAt       DateTime?          @map("starts_at")
  endsAt         DateTime?          @map("ends_at")
  active         Boolean            @default(true)
  maxRedemptions Int?               @map("max_redemptions")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  teacher     User                     @relation("CourseCouponTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  course      Course?                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  redemptions CourseCouponRedemption[]
  purchases   CoursePurchase[]

  @@unique([teacherId, code])
  @@index([teacherId, active])
  @@index([courseId])
  @@map("course_coupons")
}

model CourseCouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  purchaseId String   @unique @map("purchase_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  coupon   CourseCoupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  purchase CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([couponId, studentId])
  @@index([couponId, redeemedAt])
  @@index([studentId])
  @@map("course_coupon_redemptions")
}

model CourseQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  body      String
  /// Moderation: a teacher or admin suppressed this. Nothing to do with consent.
  hidden    Boolean  @default(false)
  /// QLT-10: the STUDENT's consent to publish, deliberately separate from `hidden`.
  /// Publication requires isPublic AND NOT hidden. Conflating the two would mean a teacher
  /// restoring a moderated question also published one the student never agreed to share.
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User          @relation("CourseQuestionsAsked", fields: [studentId], references: [id], onDelete: Cascade)
  answer  CourseAnswer?

  @@index([courseId, isPublic, hidden, createdAt])
  @@index([studentId])
  @@map("course_questions")
}

model CourseAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @unique @map("question_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  teacher  User           @relation("CourseAnswersWritten", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("course_answers")
}

model CourseLessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("course_lesson_progress")
}

model PaymentEvent {
  id               String          @id @default(uuid()) @db.Uuid
  paymentAttemptId String?         @map("payment_attempt_id") @db.Uuid
  provider         PaymentProvider
  providerEventId  String          @map("provider_event_id")
  eventType        String          @map("event_type")
  payload          Json
  processedAt      DateTime        @default(now()) @map("processed_at")

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentAttemptId])
  @@map("payment_events")
}

model VideoSession {
  id              String             @id @default(uuid()) @db.Uuid
  bookingId       String             @unique @map("booking_id") @db.Uuid
  livekitRoomName String             @map("livekit_room_name")
  status          VideoSessionStatus @default(scheduled)
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("video_sessions")
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @map("booking_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  teacherId       String       @map("teacher_id") @db.Uuid
  rating          Int
  comment         String
  status          ReviewStatus @default(pending)
  teacherResponse String?      @map("teacher_response")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User    @relation("ReviewsWritten", fields: [studentId], references: [id])
  teacher User    @relation("ReviewsReceived", fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
  @@map("reviews")
}

// ─── Communication ───────────────────────────────────────────────────────────

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  teacher  User      @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student  User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teacherId, studentId])
  @@index([teacherId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime? @map("read_at")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model UserNotificationPreference {
  userId         String   @id @map("user_id") @db.Uuid
  emailReminders Boolean  @default(true) @map("email_reminders")
  emailMessages  Boolean  @default(false) @map("email_messages")
  emailMarketing Boolean  @default(false) @map("email_marketing")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model EmailOutbox {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  recipient         String
  subject           String
  html              String
  category          String
  status            EmailOutboxStatus @default(pending)
  idempotencyKey    String            @unique @map("idempotency_key")
  attempts          Int               @default(0)
  maxAttempts       Int               @default(5) @map("max_attempts")
  nextAttemptAt     DateTime          @default(now()) @map("next_attempt_at")
  lockedAt          DateTime?         @map("locked_at")
  providerMessageId String?           @map("provider_message_id")
  lastError         String?           @map("last_error")
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs EmailDeliveryLog[]

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("email_outbox")
}

model EmailDeliveryLog {
  id                String              @id @default(uuid()) @db.Uuid
  outboxId          String              @map("outbox_id") @db.Uuid
  attempt           Int
  status            EmailDeliveryStatus
  provider          String
  providerMessageId String?             @map("provider_message_id")
  error             String?
  createdAt         DateTime            @default(now()) @map("created_at")

  outbox EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId, createdAt])
  @@index([status, createdAt])
  @@map("email_delivery_logs")
}

// ─── Platform Admin ──────────────────────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ─── Trust, Safety & Privacy ─────────────────────────────────────────────────

model SafetyReport {
  id          String             @id @default(uuid()) @db.Uuid
  reporterId  String             @map("reporter_id") @db.Uuid
  subjectId   String?            @map("subject_id") @db.Uuid
  category    String
  description String
  targetType  String?            @map("target_type")
  targetId    String?            @map("target_id") @db.Uuid
  status      SafetyReportStatus @default(submitted)
  resolution  String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  resolvedAt  DateTime?          @map("resolved_at")

  reporter User  @relation("SafetyReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  subject  User? @relation("SafetyReportSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([subjectId, status])
  @@index([status, createdAt])
  @@map("safety_reports")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model ModerationCase {
  id              String               @id @default(uuid()) @db.Uuid
  type            ModerationCaseType
  status          ModerationCaseStatus @default(open)
  priority        CasePriority         @default(normal)
  title           String
  summary         String
  reporterId      String?              @map("reporter_id") @db.Uuid
  subjectId       String?              @map("subject_id") @db.Uuid
  assignedAdminId String?              @map("assigned_admin_id") @db.Uuid
  resolution      String?
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  reporter      User?          @relation("ModerationCaseReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  subject       User?          @relation("ModerationCaseSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  assignedAdmin User?          @relation("ModerationCaseAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  refundRequest RefundRequest?
  messages      CaseMessage[]
  notes         CaseNote[]
  evidence      CaseEvidence[]
  sanctions     Sanction[]
  appeals       Appeal[]

  @@index([status, priority, createdAt])
  @@index([reporterId])
  @@index([subjectId])
  @@index([assignedAdminId, status])
  @@map("moderation_cases")
}

model CaseMessage {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User           @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([senderId])
  @@map("case_messages")
}

model CaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("case_notes")
}

model CaseEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @map("case_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  storagePath  String   @map("storage_path")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String?
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  case       ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([storagePath])
  @@map("case_evidence")
}

/// INT-13: sanctions-list screening outcome. Distinct from the Sanction model below, which
/// is a moderation penalty issued by an admin and has nothing to do with trade sanctions.
enum SanctionsScreeningStatus {
  not_screened
  clear
  review_required

  @@map("sanctions_screening_status")
}

enum ComplianceEventKind {
  jurisdiction_blocked
  screening_clear
  screening_review_required
  screening_unavailable

  @@map("compliance_event_kind")
}

/// INT-13: an audit trail for compliance decisions that have no admin actor.
///
/// AdminAuditLog requires an adminUserId, so it cannot record a registration refused by an
/// automated jurisdiction check — there is no admin in that flow, and the user may not exist
/// yet, which is why email is stored alongside the optional user reference.
model ComplianceEvent {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  email       String?
  kind        ComplianceEventKind
  countryCode String?             @map("country_code") @db.VarChar(2)
  detail      Json?
  createdAt   DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind, createdAt])
  @@map("compliance_events")
}

model Sanction {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  caseId        String?            @map("case_id") @db.Uuid
  issuedById    String             @map("issued_by_id") @db.Uuid
  type          SanctionType
  scopes        EnforcementScope[] @default([])
  reason        String
  evidence      String?
  startsAt      DateTime           @default(now()) @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  revokedAt     DateTime?          @map("revoked_at")
  revokedReason String?            @map("revoked_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User            @relation("SanctionSubject", fields: [userId], references: [id], onDelete: Restrict)
  case     ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  issuedBy User            @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  appeals  Appeal[]

  @@index([userId, startsAt, endsAt])
  @@index([caseId])
  @@index([type])
  @@map("sanctions")
}

model Appeal {
  id          String       @id @default(uuid()) @db.Uuid
  sanctionId  String       @map("sanction_id") @db.Uuid
  caseId      String?      @map("case_id") @db.Uuid
  appellantId String       @map("appellant_id") @db.Uuid
  status      AppealStatus @default(submitted)
  reason      String
  evidence    String?
  reviewerId  String?      @map("reviewer_id") @db.Uuid
  decision    String?
  submittedAt DateTime     @default(now()) @map("submitted_at")
  reviewedAt  DateTime?    @map("reviewed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  sanction  Sanction        @relation(fields: [sanctionId], references: [id], onDelete: Restrict)
  case      ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  appellant User            @relation("AppealAppellant", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewer  User?           @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([sanctionId, appellantId])
  @@index([status, submittedAt])
  @@index([appellantId])
  @@map("appeals")
}

model PrivacyRequest {
  id              String               @id @default(uuid()) @db.Uuid
  requesterId     String               @map("requester_id") @db.Uuid
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(submitted)
  details         String?
  response        String?
  assignedAdminId String?              @map("assigned_admin_id") @db.Uuid
  submittedAt     DateTime             @default(now()) @map("submitted_at")
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  requester     User  @relation("PrivacyRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedAdmin User? @relation("PrivacyRequestAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([requesterId, submittedAt])
  @@index([status, submittedAt])
  @@index([assignedAdminId, status])
  @@map("privacy_requests")
}
