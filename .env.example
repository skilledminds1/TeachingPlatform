# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional): NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase → Settings → Database → Connection string)
# Replace [YOUR-DB-PASSWORD] and verify region in pooler hostname (e.g. aws-0-eu-central-1)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# PayFast — platform teacher subscriptions only
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Live checkout requires public HTTPS app URL (ngrok or deployed domain). localhost + live = CloudFront 403.
# MUST be "false" in production. It defaults to "true", and a production deploy that omits it
# routes every live checkout to the PayFast sandbox while booting perfectly happily — the boot
# check now refuses that rather than letting the only revenue line silently not happen.

# Student -> teacher lesson payments
# There is nothing to configure. Teachers save a hosted-checkout link from their own payment
# provider (src/lib/payments/payment-links.ts holds the allowlist) and students are sent
# straight there. The platform holds no keys and receives no webhook, because it never
# touches that money.

# Video
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email
# resend in production; console logs metadata without sending
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=Amazing Skills <noreply@yourdomain.com>

# Legal identity — replace every placeholder before launch
LEGAL_ENTITY_NAME=
LEGAL_REGISTRATION_NUMBER=
LEGAL_BUSINESS_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_INFORMATION_OFFICER_EMAIL=
# Random secret used only to hash request evidence for agreement records
LEGAL_EVIDENCE_SALT=

# Protected jobs and deep readiness (use long random values)
CRON_SECRET=
# Optional; readiness falls back to CRON_SECRET when omitted
HEALTH_SECRET=

# Rate limiting uses the application's own Postgres (the rate_limits table) — no separate
# service, no extra variables. It shares DATABASE_URL, so if the database is reachable the
# limiter works.

# Sentry (optional; integration is disabled when DSNs are empty)
# COMMENTED OUT, not blank: these are z.string().url(), and an empty value is
# present-and-invalid, so it fails the parse at module load and every page 500s.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Only needed in CI/deploy when uploading source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Encryption key for OAuth tokens held at rest (AES-256-GCM), base64 of 32 random bytes.
# REQUIRED for the Google Calendar integration: without it the integration stays disabled
# rather than storing refresh tokens in plaintext (SEC-11).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
