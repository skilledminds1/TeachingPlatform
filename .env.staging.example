# Staging environment — a throwaway Supabase project used to walk the product end to end
# without touching the live database that serves amazing-skills.com.
#
# Copy to .env.staging and fill in from the Supabase dashboard of a NEW project.
# .env.staging is gitignored along with every other .env file.
#
#   Settings → Data API            → Project URL, publishable/anon key, service_role key
#   Settings → Database            → Connection string (Transaction pooler and Direct)
#
# Then:
#   npx dotenv -e .env.staging -- prisma migrate deploy
#   npx dotenv -e .env.staging -- prisma db seed
#   npm run seed:walkthrough -- --env .env.staging --yes

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler, port 6543
DATABASE_URL=postgresql://postgres.YOUR-STAGING-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection, port 5432 — migrations run against this one
DIRECT_URL=postgresql://postgres.YOUR-STAGING-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Video. Reuse the existing LiveKit project — rooms are per-booking and short-lived, so a
# staging booking cannot collide with a production one.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email stays on the console provider: a walkthrough must not send real mail to anyone.
EMAIL_PROVIDER=console
RESEND_FROM_EMAIL=Amazing Skills <noreply@example.com>

# Not the production values. These only need to satisfy the boot check in a dev run.
LEGAL_ENTITY_NAME=Staging Entity
LEGAL_REGISTRATION_NUMBER=0000/000000/00
LEGAL_BUSINESS_ADDRESS=Staging address
LEGAL_SUPPORT_EMAIL=support@staging.invalid
LEGAL_INFORMATION_OFFICER_EMAIL=privacy@staging.invalid
LEGAL_EVIDENCE_SALT=staging-evidence-salt-change-me

# Both must be at least 32 characters or the env schema rejects them.
CRON_SECRET=staging-cron-secret-at-least-32-characters-long
HEALTH_SECRET=staging-health-secret-at-least-32-characters-long

# base64 of exactly 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Lesson payments stay off — the walkthrough confirms bookings by teacher acceptance.
LESSON_PAYMENTS_PAYPAL_ENABLED=false
LESSON_PAYMENT_TIMEOUT_MINUTES=30
